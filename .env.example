# ─────────────────────────────────────────────────────────────────────────────
# PDF Utility — environment configuration
#
# The MVP requires NO API keys or third-party service credentials.
# Everything below is optional tuning for limits, rate limiting and cleanup.
# Copy to `.env.local` (git-ignored) to override defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Upload / processing limits ───────────────────────────────────────────────
# Maximum size of a single uploaded PDF, in megabytes (PRD: 50 MB)
MAX_FILE_SIZE_MB=50
# Maximum number of PDFs per merge session (PRD: 20)
MAX_FILES_PER_SESSION=20
# Maximum total pages a single processing job may include (PRD: 100)
MAX_TOTAL_PAGES=100

# ── Jobs & temporary storage ─────────────────────────────────────────────────
# Base directory for temporary job files. Defaults to `<os tmp dir>/pdf-utility`.
# TMP_DIR=
# How long jobs and their files are kept, in milliseconds (max 1 hour per PRD)
JOB_TTL_MS=3600000
# How often the automatic cleanup sweeper runs, in milliseconds
SWEEP_INTERVAL_MS=60000
# Maximum number of jobs processing simultaneously across the whole server
MAX_CONCURRENT_JOBS=2

# ── Rate limiting (requests per minute per IP, per route class) ──────────────
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_VALIDATE_PER_MIN=10
RATE_LIMIT_JOBS_PER_MIN=10
RATE_LIMIT_DOWNLOAD_PER_MIN=60
RATE_LIMIT_PAGES_PER_MIN=240
